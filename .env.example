# Local development environment variables for `netlify dev`.
#
# Copy this file to `.env` (which is already git-ignored) and fill in the real
# value provided by whoever holds the company Google API key.
#
#   cp .env.example .env
#
# Rules:
#   - Do NOT commit the real key (.env is git-ignored).
#   - Do NOT prefix this with VITE_ — that would inline it into the client bundle.
#   - This is read only server-side by netlify/functions/reviews.js.
#
# In production, this same variable name must be set in the Netlify dashboard
# (Site settings -> Environment variables), not in any file.

GOOGLE_PLACES_API_KEY=
